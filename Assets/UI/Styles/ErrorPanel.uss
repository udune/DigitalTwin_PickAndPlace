/* ============================================
   ErrorPanel.uss - 에러 패널 스타일
   ============================================ */

/* === 에러 패널 컨테이너 === */
.error-panel {
    position: absolute;
    top: 44px;
    left: 12px;
    width: 380px;
    max-height: 400px;
    background-color: var(--color-panel);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--color-border);
    padding: 0;
    opacity: 0;
    transition: opacity 0.3s ease-out;
}

.error-panel.visible {
    opacity: 1;
}

/* === 패널 헤더 === */
.error-panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.error-panel-title {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotoSansKR-Bold%20SDF.otf");
    font-size: 13px;
    color: #FFFFFF;
}

.clear-history-button {
    background-color: transparent;
    border-width: 0;
    padding: 4px 8px;
    font-size: 11px;
    color: var(--color-text-secondary);
    transition: color 0.15s ease-out;
}

.clear-history-button:hover {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
}

/* === 에러 스크롤 영역 === */
.error-scroll {
    flex-grow: 1;
    max-height: 340px;
}

.error-container {
    padding: 8px;
    flex-direction: column;
}

/* === 개별 에러 아이템 === */
.error-item {
    flex-direction: row;
    margin-bottom: 6px;
    background-color: rgba(40, 40, 40, 0.8);
    border-radius: 6px;
    overflow: hidden;
    opacity: 0;
    translate: 30px 0;
    transition: opacity 0.3s ease-out, translate 0.3s ease-out;
}

.error-item.visible {
    opacity: 1;
    translate: 0 0;
}

.error-item.resolved {
    opacity: 0.5;
}

/* === 에러 좌측 보더 (타입 표시) === */
.error-border {
    width: 4px;
    background-color: var(--color-error);
}

.error-border.warning {
    background-color: var(--color-warning);
}

.error-border.resolved {
    background-color: var(--color-resolved);
}

/* === 에러 내용 영역 === */
.error-content {
    flex-grow: 1;
    padding: 10px 12px;
}

/* === 에러 헤더 (위치 + 타임스탬프) === */
.error-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.error-badge {
    padding: 2px 6px;
    border-radius: 3px;
    background-color: var(--color-error);
    margin-right: 8px;
}

.error-badge.warning {
    background-color: var(--color-warning);
}

.error-badge.resolved {
    background-color: var(--color-resolved);
}

.error-badge-text {
    font-size: 10px;
    color: #FFFFFF;
    -unity-font-style: bold;
}

.error-location {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/NotoSansKR-Bold%20SDF.otf");
    font-size: 13px;
    color: #FFFFFF;
    flex-grow: 1;
}

.error-location.resolved {
    color: var(--color-text-secondary);
}

.error-timestamp {
    font-size: 11px;
    color: var(--color-text-secondary);
}

/* === 에러 메시지 === */
.error-message {
    font-size: 12px;
    color: #CCCCCC;
    white-space: normal;
}

.error-message.resolved {
    color: var(--color-text-secondary);
}
