/* ============================================
   ConnectionStatus.uss - 연결 상태 표시 스타일
   ============================================ */

.connection-status {
    position: absolute;
    top: 44px;
    right: 12px;
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: var(--color-panel);
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--color-border);
}

.connection-indicator {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin-right: 8px;
    background-color: var(--color-disconnected);
    transition: background-color 0.3s ease-out;
}

.connection-indicator.connected {
    background-color: var(--color-connected);
}

.connection-indicator.connecting {
    background-color: var(--color-connecting);
}

.connection-indicator.disconnected {
    background-color: var(--color-disconnected);
}

/* 깜빡임 애니메이션 - connecting, disconnected 상태 */
.connection-indicator.blink {
    transition: opacity 0.5s ease-in-out;
}

.connection-status-text {
    font-size: 12px;
    color: #CCCCCC;
    margin-right: 10px;
    min-width: 90px;
}

.reconnect-button {
    background-color: rgb(70, 70, 70);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 11px;
    color: #FFFFFF;
    transition: background-color 0.15s ease-out, opacity 0.2s ease-out;
}

.reconnect-button:hover {
    background-color: rgb(90, 90, 90);
}

.reconnect-button:active {
    background-color: rgb(60, 60, 60);
}

.reconnect-button.hidden {
    display: none;
}
